# --- Backend ---
# Vacío = modo simulado (sin servidor Nx).
NX_URL=
# NX_URL=https://nx-servidor.local:7001
NX_USERNAME=admin
NX_PASSWORD=
NX_VERIFY_TLS=false
# Vacío = se toma de /rest/v3/system/info (cloudId).
NX_SYSTEM_ID=
# Nx Cloud: {systemId}.relay.vmsproxy.com  |  Servidor local: nx-servidor.local:7001 + NX_USE_RELAY_PREFIX=false
NX_RELAY_URL={systemId}.relay.vmsproxy.com
NX_USE_RELAY_PREFIX=true
WEBHOOK_SECRET=cambiar-este-secreto

# --- Worker de IA ---
VIDEO_SOURCE=rtsp://mediamtx:8554/test
NX_CAMERA_ID=
# Ruta a un modelo YOLO exportado a ONNX (vacío = detección de movimiento).
MODEL_PATH=
ANALYSIS_FPS=2
WATCH_LABELS=persona,coche
ALERT_COOLDOWN_S=30
